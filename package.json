{
  "name": "centaur-werewolf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p . && tsc -p convex",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "^1.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
